{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linkedin-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Public app identifier for the built-in OAuth connect flow.
    // The client secret is a Worker secret: npx wrangler secret put LI_CLIENT_SECRET
    "LI_CLIENT_ID": "your-linkedin-client-id"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": {
    // Publish check every 15 minutes. Actual posting is gated by each queue's
    // weekly slot rules, stored in D1 settings.
    "crons": ["*/15 * * * *"]
  },
  // The dashboard is a single HTML file bundled into the Worker as a string.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linkedin-scheduler",
      // npx wrangler d1 create linkedin-scheduler, then paste the id here
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
