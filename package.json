{
  "name": "linkedin-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Schedule and auto-publish LinkedIn posts on weekly slots. Cloudflare Workers, D1 and the official LinkedIn API.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  },
  "engines": {
    "node": ">=20"
  }
}
